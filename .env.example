# ─────────────────────────────────────────────────────────────
# Geek Creative Agency — environment variables
# Copy to .env.local for local development. NEVER commit real secrets.
# Add the same keys in Vercel → Project → Settings → Environment Variables,
# scoped per environment (Development / Preview / Production).
#
# The PUBLIC STATIC SITE needs NONE of the CMS variables to build or render.
# They are required only for /admin and /api (the Payload CMS).
# ─────────────────────────────────────────────────────────────

# ── Payload CMS — required to run /admin + /api ──
# Managed Postgres connection string (Neon today; any Postgres later).
# Use a SEPARATE database/branch per environment — never point local at prod.
#   local:      a local or a Neon dev branch
#   staging:    a dedicated Neon staging branch/database
#   production: the production Neon database
DATABASE_URL=

# Long random string — signs Payload auth tokens. Generate: openssl rand -hex 32
# Different value per environment. Never committed; no production fallback.
PAYLOAD_SECRET=

# ── Public CMS media storage — Vercel Blob (required for CMS uploads) ──
# Vercel → Storage → Blob → token. Server-side only; never exposed to the browser.
# Admin works read-only without it; uploads need it.
BLOB_READ_WRITE_TOKEN=

# ── Site origin — required (drives canonical/OG/sitemap + Payload serverURL) ──
# *.vercel.app auto → noindex,nofollow + robots Disallow: /
# Change ONLY this to migrate to the final domain.
#   local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://geek-creative-agency.vercel.app

# ── Future (Phase 4+, not required yet) ──
# PREVIEW_SECRET=

# ── Existing (forms / analytics) ──
RESEND_API_KEY=
LEAD_TO_EMAIL=
# NEXT_PUBLIC_GA_ID=
